{
  "openapi": "3.0.0",
  "info": {
    "title": "PorishkarBD - Waste Reports API",
    "description": "Feature 01: Waste Reports API documentation",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://porishkar-bd.onrender.com",
      "description": "Production backend server"
    }
  ],
  "tags": [
    {
      "name": "Waste Reports",
      "description": "Feature 01 - Waste reporting operations"
    }
  ],
  "paths": {
    "/api/reports/my": {
      "get": {
        "tags": ["Waste Reports"],
        "summary": "Retrieve my waste reports",
        "description": "Retrieves all waste reports submitted by the currently authenticated user, sorted by creation date, newest first. The reportedBy and assignedCollector fields contain user IDs.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User's reports retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "reports": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/WasteReport"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Server error"
                    },
                    "error": {
                      "type": "string",
                      "description": "Additional error details, when provided."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/reports/{id}": {
      "get": {
        "tags": ["Waste Reports"],
        "summary": "Retrieve a waste report by ID",
        "description": "Retrieves a specific waste report. Only the report owner or an administrator can access it. The reportedBy field is populated with name, email, and phone.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "MongoDB report ID",
            "schema": {
              "type": "string",
              "example": "672a12345678901234567890"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Report retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "report": {
                      "$ref": "#/components/schemas/DetailedWasteReport"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "User is not authorized to view this report"
          },
          "404": {
            "description": "Report not found"
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Server error"
                    },
                    "error": {
                      "type": "string",
                      "description": "Additional error details, when provided."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/reports": {
      "post": {
        "tags": ["Waste Reports"],
        "summary": "Create a waste report",
        "description": "Allows an authenticated citizen to submit a waste report with optional images. The location field must contain a JSON string with lat, lng, and address. Maximum 5 images are allowed.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["category", "description", "location"],
                "properties": {
                  "category": {
                    "type": "string",
                    "enum": [
                      "Household",
                      "Industrial",
                      "Medical",
                      "Construction",
                      "Water Body Pollution"
                    ],
                    "example": "Household"
                  },
                  "description": {
                    "type": "string",
                    "example": "Household waste dumped beside the road."
                  },
                  "location": {
                    "type": "string",
                    "description": "JSON string containing lat, lng, and address.",
                    "example": "{\"lat\":23.7806,\"lng\":90.407,\"address\":\"Dhaka, Bangladesh\"}"
                  },
                  "estimatedVolume": {
                    "type": "string",
                    "enum": ["Small", "Medium", "Large"],
                    "default": "Medium",
                    "example": "Medium"
                  },
                  "images": {
                    "type": "array",
                    "maxItems": 5,
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Report submitted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Report submitted successfully"
                    },
                    "ecoPoints": {
                      "type": "object",
                      "nullable": true,
                      "properties": {
                        "pointsEarned": {
                          "type": "number",
                          "example": 10
                        },
                        "newBalance": {
                          "type": "number",
                          "example": 50
                        }
                      }
                    },
                    "report": {
                      "$ref": "#/components/schemas/CreatedReport"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Required fields missing, invalid location format, or missing location properties",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Possible messages: Category, description, and location are required; Invalid location format; Location must include lat, lng, and address.",
                      "example": "Category, description, and location are required"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Only citizens can submit waste reports"
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Server error"
                    },
                    "error": {
                      "type": "string",
                      "description": "Additional error details, when provided."
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": ["Waste Reports"],
        "summary": "Retrieve all waste reports",
        "description": "Allows an authenticated administrator to retrieve all waste reports. Reporter name and email are populated. Reports are sorted by creation date, newest first.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Reports retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "reports": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PopulatedWasteReport"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin access required"
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Server error"
                    },
                    "error": {
                      "type": "string",
                      "description": "Additional error details, when provided."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
