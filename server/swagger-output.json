            "example": "Household"
          },
          "description": {
            "type": "string",
            "example": "Household waste dumped beside the road."
          },
          "location": {
            "type": "object",
            "required": ["lat", "lng", "address"],
            "properties": {
              "lat": {
                "type": "number",
                "example": 23.7806
              },
              "lng": {
                "type": "number",
                "example": 90.407
              },
              "address": {
                "type": "string",
                "example": "Dhaka, Bangladesh"
              }
            }
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "example": "Reported"
          },
          "estimatedVolume": {
            "type": "string",
            "enum": ["Small", "Medium", "Large"],
            "example": "Medium"
          },
          "priority": {
            "type": "string",
            "enum": ["Low", "Medium", "High", "Critical"],
            "example": "Medium"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
